{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/tools/claude_hooks/subagent_model_router.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/tools/claude_hooks/workflow_agent_type_default.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "autoCompactWindow": 300000,
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 300000
    }
  },
  "permissions": {
    "deny": [
      "SuggestPluginInstall",
      "SearchPlugins",
      "SuggestSkills",
      "mcp__visualize",
      "mcp__claude_ai_Claude_Docs"
    ]
  },
  "enabledPlugins": {
    "flutter-all@flutter-claude-code": false,
    "rust-fushi-lsp@local-plugins": false,
    "dart-lsp@local-plugins": false,
    "frontend-design@claude-plugins-official": false
  }
}
