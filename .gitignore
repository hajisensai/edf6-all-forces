# Build output (build.cmd: build/Mods/Plugins holds the plugins and their ini files) and release packages
build/
release/
# The old output directory: the plugins were built into dist/ and tracked there until 0.7.1
dist/
# Scratch notes and probes, never tracked (finished notes go to docs/)
tmp/
backup/
probe/
*.pyc
__pycache__/
*.log
testrange/testrange.json
testrange/runs/
# User-supplied vehicle models (pylib/obj_model.py model_dir): never committed, but for the cockpits: their cut
# interiors (tools/prep_cockpit_*.py from the Sketchfab sources, CC BY / CC0, models/cockpits/CREDITS_*.txt) are the
# data the installer grafts, tracked so that CI's release carries the same ones the code that reads them was made for
models/*
!models/cockpits/

# Development-only data (tools/make_edf41_objects.py --mother-dev): never committed, never in a release
edf41port_dev/

# EDF4.1 asset packs (tools/export_edf41_assets.py; pylib/edf41src.py looks for edf41/ next to the installer): never committed
/edf41/
